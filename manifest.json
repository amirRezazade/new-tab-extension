{
  "manifest_version": 3,
  "name": "NovaTab — Bookmarks & New Tab",
  "version": "1.9.4",
  "description": "NovaTab is a customizable bookmarks dashboard with a toolbar popup for saving the current page into a tab and group.",
  "permissions": ["storage", "activeTab", "favicon"],
  "host_permissions": ["https://geocoding-api.open-meteo.com/*", "https://api.open-meteo.com/*"],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Save this page to NovaTab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:"
  }
}
